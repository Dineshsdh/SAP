<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
 
    <Dialog
        id="createPODialog"
        title="Create Purchase Order"
        contentWidth="600px"
        draggable="true"
        resizable="true">
 
        <content>
 
            <VBox class="sapUiMediumMargin">
 
                <Title
                    text="Selected PR Details"
                    level="H3"
                    class="sapUiSmallMarginBottom" />
 
                <Label text="PR Number" />
 
                <Input
                    id="createPOPRNumber"
                    value="{dashboard>/selectedPR/PurReqNumber}"
                    editable="false" />
 
                <Label
                    text="PR Item"
                    class="sapUiSmallMarginTop" />
 
                <TextArea
                    id="createPOPRItem"
                    rows="3"
                    editable="false"
                    value="{dashboard>/selectedPRItems}" />
                <Label
                    text="Material"
                    class="sapUiSmallMarginTop" />
 
                <Input
                    value="{dashboard>/selectedPR/MaterialNo}"
                    editable="false" />
 
                <Label
                    text="Vendor"
                    class="sapUiSmallMarginTop" />
 
                <Input
                    value="{dashboard>/selectedPR/FixedVendorName}"
                    editable="false" />
 
                <Label
                    text="Plant"
                    class="sapUiSmallMarginTop" />
 
                <Input
                    value="{dashboard>/selectedPR/PlantCode}"
                    editable="false" />
 
                <Label
                    text="Quantity"
                    class="sapUiSmallMarginTop" />
 
                <Input
                    value="{dashboard>/selectedPR/OrderQuantity}"
                    editable="false" />
 
            </VBox>
 
        </content>
 
        <beginButton>
 
            <Button
                text="Confirm PO"
                type="Emphasized"
                icon="sap-icon://create"
                press=".onConfirmCreatePO" />
 
        </beginButton>
 
        <endButton>
 
            <Button
                text="Cancel"
                press=".onCloseCreatePO" />
 
        </endButton>
 
    </Dialog>
 
</core:FragmentDefinition>